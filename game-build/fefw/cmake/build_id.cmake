# Run at every build (cmake -P, from the fefw_build_id target): writes OUT, a header with FEFW_BUILD_ID, the release version (from
# launcher/package.json) and `git describe` of the source tree when it is a git checkout. The log's first line and the crash and device-lost
# reports carry it, so a report says which build it came from. The file is only rewritten when the text changes, so an unchanged checkout
# rebuilds nothing.
set(ver "")
if(EXISTS "${ROOT}/launcher/package.json")
    file(READ "${ROOT}/launcher/package.json" pj)
    if(pj MATCHES "\"version\"[ \t\r\n]*:[ \t\r\n]*\"([^\"]+)\"")
        set(ver "${CMAKE_MATCH_1}")
    endif()
endif()
set(git "")
if(EXISTS "${ROOT}/.git")
    find_package(Git QUIET)
    if(GIT_FOUND)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" describe --tags --always --dirty --abbrev=7
                        OUTPUT_VARIABLE git OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
        if(NOT rc EQUAL 0)
            set(git "")
        endif()
    endif()
endif()
if(NOT git)
    set(git "no git checkout")
endif()
if(NOT ver)
    set(ver "(version unknown)")
endif()
string(REPLACE "\"" "" git "${git}")
set(content "// generated by cmake/build_id.cmake\n#pragma once\n#define FEFW_BUILD_ID \"fefw ${ver} (${git})\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
