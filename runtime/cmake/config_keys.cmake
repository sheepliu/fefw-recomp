# Writes the list of known ini keys (section and key) for config_log_unread (src/diag/config.cpp): every literal
# config_get_*/config_has/config_source("section", "key") call under ROOTS, plus every row of DOC (docs/CONFIG.md).
# A key read through a variable is missing unless CONFIG.md lists it. Run with: cmake -DROOTS=a;b -DDOC=f -DOUT=f -P config_keys.cmake
set(_keys "")
foreach(_root IN LISTS ROOTS)
    if(NOT IS_DIRECTORY "${_root}")
        continue()
    endif()
    file(GLOB_RECURSE _files "${_root}/*.cpp" "${_root}/*.h")
    foreach(_f IN LISTS _files)
        file(STRINGS "${_f}" _lines REGEX "config_(get_(str|int|bool|double)|has|source)\\(\"[a-z0-9_]*\", *\"[a-z0-9_]+\"")
        foreach(_l IN LISTS _lines)
            string(REGEX MATCHALL "config_(get_(str|int|bool|double)|has|source)\\(\"[a-z0-9_]*\", *\"[a-z0-9_]+\"" _ms "${_l}")
            foreach(_m IN LISTS _ms)
                string(REGEX REPLACE ".*\\(\"([a-z0-9_]*)\", *\"([a-z0-9_]+)\"" "\\1/\\2" _k "${_m}")
                list(APPEND _keys "${_k}")
            endforeach()
        endforeach()
    endforeach()
endforeach()
if(EXISTS "${DOC}")
    file(STRINGS "${DOC}" _rows REGEX "^\\| `[a-z0-9_]+` \\| `[a-z0-9_]+` \\|")
    foreach(_r IN LISTS _rows)
        string(REGEX REPLACE "^\\| `([a-z0-9_]+)` \\| `([a-z0-9_]+)` \\|.*" "\\1/\\2" _k "${_r}")
        list(APPEND _keys "${_k}")
    endforeach()
endif()
list(REMOVE_DUPLICATES _keys)
list(SORT _keys)
set(_text "// Generated by cmake/config_keys.cmake: the ini keys the code reads by name and the keys docs/CONFIG.md lists. \"section/key\".\n")
foreach(_k IN LISTS _keys)
    string(APPEND _text "\"${_k}\",\n")
endforeach()
file(WRITE "${OUT}.tmp" "${_text}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
