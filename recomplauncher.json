{
    "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
    "format": 1,
    "repo": "metrist38/fefw-recomp",
    "requires": [
        "start",
        "setup",
        "exit_codes",
        "settings.ini",
        "settings.choices",
        "settings.slider",
        "settings.groups"
    ],
    "system": {
        "windows": {
            "version": "10",
            "graphics": {
                "vulkan": "1.3"
            }
        },
        "linux": {
            "graphics": {
                "vulkan": "1.3"
            }
        }
    },
    "game": {
        "kind": "iso_or_folder",
        "label": "Your decrypted dump of Fire Emblem: Fortune's Weave for Nintendo Switch 2 at update 131072: a folder with exefs/ and romfs/ (or base/ and updates/<version>/), or its .nup package.",
        "check": {
            "nup_build_id": "db93b0125f4850601d61c3edde012f8eb2ecfe77"
        }
    },
    "inputs": [
        {
            "id": "dlc",
            "label": "Your dumped DLC (optional): the dlc folder with one folder per title id, each with a romfs folder in it. Leave empty to use dlc/ inside your game dump.",
            "role": "dlc",
            "optional": true,
            "formats": [
                {
                    "type": "folder"
                }
            ]
        }
    ],
    "prepare": {
        "program": [
            "fefw-launcher.exe",
            "fefw-launcher.AppImage"
        ],
        "args": [
            "--prepare",
            "--game",
            "{game}",
            "--dlc={input:dlc}"
        ],
        "label": "Building the game from your dump",
        "timeout": 7200,
        "done": [
            "{install}/fefw.exe"
        ]
    },
    "start": {
        "program": [
            "fefw.exe"
        ]
    },
    "exit_codes": {
        "3": "fefw.exe and fefw_rt.dll are from different releases. Run Set up again.",
        "4": "This processor is too old for this build of the game. See fefw_fatal.txt in the install folder."
    },
    "saves": [
        "{install}/save"
    ],
    "folders": {
        "saves": [
            {
                "path": "{install}/save"
            }
        ],
        "logs": [
            {
                "path": "{install}"
            }
        ],
        "mods": [
            {
                "path": "{install}/mods"
            }
        ]
    },
    "actions": [
        {
            "id": "open_mods",
            "label": "Open mods folder",
            "open": "mods"
        }
    ],
    "config": [
        {
            "id": "main",
            "format": "ini",
            "file": [
                {
                    "path": "{install}/fefw.ini"
                }
            ]
        }
    ],
    "settings": [
        {
            "id": "preset",
            "label": "Graphics preset",
            "help": "Sets render scale, shadow map size, quality, and graphics detail together. Applies at the next start.",
            "group": "Picture",
            "defaults": {
                "fefw/render_ratio": "0",
                "fefw/shadow_size": "0",
                "fefw/quality": "console",
                "fefw/reflections": "full",
                "fefw/ambient_occlusion": "1",
                "fefw/crowd_detail": "full",
                "fefw/scenery_detail": "full"
            },
            "choices": [
                {
                    "label": "Low",
                    "set": {
                        "fefw/render_ratio": "0.5",
                        "fefw/shadow_size": "1024",
                        "fefw/quality": "handheld",
                        "fefw/reflections": "reduced",
                        "fefw/ambient_occlusion": "0",
                        "fefw/crowd_detail": "reduced",
                        "fefw/scenery_detail": "reduced"
                    }
                },
                {
                    "label": "Medium (console)",
                    "set": {
                        "fefw/render_ratio": "0",
                        "fefw/shadow_size": "0",
                        "fefw/quality": "console",
                        "fefw/reflections": "full",
                        "fefw/ambient_occlusion": "1",
                        "fefw/crowd_detail": "full",
                        "fefw/scenery_detail": "full"
                    }
                },
                {
                    "label": "High",
                    "set": {
                        "fefw/render_ratio": "0.67",
                        "fefw/shadow_size": "4096",
                        "fefw/quality": "docked",
                        "fefw/reflections": "full",
                        "fefw/ambient_occlusion": "1",
                        "fefw/crowd_detail": "full",
                        "fefw/scenery_detail": "full"
                    }
                },
                {
                    "label": "Ultra",
                    "set": {
                        "fefw/render_ratio": "1.0",
                        "fefw/shadow_size": "8192",
                        "fefw/quality": "docked",
                        "fefw/reflections": "full",
                        "fefw/ambient_occlusion": "1",
                        "fefw/crowd_detail": "full",
                        "fefw/scenery_detail": "full"
                    }
                }
            ]
        },
        {
            "id": "output",
            "label": "Output resolution",
            "help": "The size the game draws at. Applies at the next start.",
            "group": "Picture",
            "defaults": {
                "fefw/output": "console"
            },
            "choices": [
                {
                    "label": "Console (docked 1440p)",
                    "set": {
                        "fefw/output": "console"
                    }
                },
                {
                    "label": "720p",
                    "set": {
                        "fefw/output": "720p"
                    }
                },
                {
                    "label": "1080p",
                    "set": {
                        "fefw/output": "1080p"
                    }
                },
                {
                    "label": "1440p",
                    "set": {
                        "fefw/output": "1440p"
                    }
                },
                {
                    "label": "4K (2160p)",
                    "set": {
                        "fefw/output": "2160p"
                    }
                },
                {
                    "label": "2560 x 1080 (21:9)",
                    "set": {
                        "fefw/output": "2560x1080"
                    }
                },
                {
                    "label": "3440 x 1440 (21:9)",
                    "set": {
                        "fefw/output": "3440x1440"
                    }
                },
                {
                    "label": "5120 x 1440 (32:9)",
                    "set": {
                        "fefw/output": "5120x1440"
                    }
                },
                {
                    "label": "Window size at start",
                    "set": {
                        "fefw/output": "window"
                    }
                }
            ]
        },
        {
            "id": "ultrawide",
            "label": "Ultrawide",
            "help": "With an output wider than 16:9 the 3D view widens; menus and HUD stay centred at 16:9.",
            "group": "Picture",
            "defaults": {
                "fefw/ultrawide": "auto"
            },
            "choices": [
                {
                    "label": "Auto",
                    "set": {
                        "fefw/ultrawide": "auto"
                    }
                },
                {
                    "label": "Off (stretch 16:9)",
                    "set": {
                        "fefw/ultrawide": "off"
                    }
                }
            ]
        },
        {
            "id": "render_ratio",
            "label": "Render scale",
            "help": "3D render size per side as a share of the output; the upscaler fills in the rest.",
            "group": "Picture",
            "defaults": {
                "fefw/render_ratio": "0"
            },
            "choices": [
                {
                    "label": "Game's own (50%)",
                    "set": {
                        "fefw/render_ratio": "0"
                    }
                },
                {
                    "label": "33% (Ultra Performance)",
                    "set": {
                        "fefw/render_ratio": "0.33"
                    }
                },
                {
                    "label": "50% (Performance)",
                    "set": {
                        "fefw/render_ratio": "0.5"
                    }
                },
                {
                    "label": "59% (Balanced)",
                    "set": {
                        "fefw/render_ratio": "0.59"
                    }
                },
                {
                    "label": "67% (Quality)",
                    "set": {
                        "fefw/render_ratio": "0.67"
                    }
                },
                {
                    "label": "75% (Ultra Quality)",
                    "set": {
                        "fefw/render_ratio": "0.75"
                    }
                },
                {
                    "label": "85% (High Quality)",
                    "set": {
                        "fefw/render_ratio": "0.85"
                    }
                },
                {
                    "label": "100% (Native)",
                    "set": {
                        "fefw/render_ratio": "1.0"
                    }
                }
            ]
        },
        {
            "id": "upscaler",
            "label": "Upscaler",
            "help": "TAAU needs no extra files. The others need their vendor's DLLs: download them in fefw-launcher (Settings > Graphics) or see docs/UPSCALERS.md on GitHub. If one is missing the game falls back to TAAU.",
            "group": "Picture",
            "defaults": {
                "dlss/upscaler": "taau"
            },
            "choices": [
                {
                    "label": "Built-in temporal (TAAU)",
                    "set": {
                        "dlss/upscaler": "taau"
                    }
                },
                {
                    "label": "NVIDIA DLSS (needs Streamline files)",
                    "set": {
                        "dlss/upscaler": "dlss"
                    }
                },
                {
                    "label": "AMD FSR 3 (needs AMD's files)",
                    "set": {
                        "dlss/upscaler": "fsr3"
                    }
                },
                {
                    "label": "Intel XeSS (needs libxess.dll)",
                    "set": {
                        "dlss/upscaler": "xess"
                    }
                },
                {
                    "label": "Bilinear",
                    "set": {
                        "dlss/upscaler": "bilinear"
                    }
                },
                {
                    "label": "Automatic",
                    "set": {
                        "dlss/upscaler": "auto"
                    }
                }
            ]
        },
        {
            "id": "quality",
            "label": "Quality",
            "group": "Picture",
            "advanced": true,
            "defaults": {
                "fefw/quality": "console"
            },
            "choices": [
                {
                    "label": "As the console picks",
                    "set": {
                        "fefw/quality": "console"
                    }
                },
                {
                    "label": "Always docked quality",
                    "set": {
                        "fefw/quality": "docked"
                    }
                },
                {
                    "label": "Always handheld quality",
                    "set": {
                        "fefw/quality": "handheld"
                    }
                }
            ]
        },
        {
            "id": "shadow_size",
            "label": "Shadow map size",
            "group": "Picture",
            "advanced": true,
            "defaults": {
                "fefw/shadow_size": "0"
            },
            "choices": [
                {
                    "label": "Game's own",
                    "set": {
                        "fefw/shadow_size": "0"
                    }
                },
                {
                    "label": "1024",
                    "set": {
                        "fefw/shadow_size": "1024"
                    }
                },
                {
                    "label": "2048",
                    "set": {
                        "fefw/shadow_size": "2048"
                    }
                },
                {
                    "label": "4096",
                    "set": {
                        "fefw/shadow_size": "4096"
                    }
                },
                {
                    "label": "8192",
                    "set": {
                        "fefw/shadow_size": "8192"
                    }
                }
            ]
        },
        {
            "id": "reflections",
            "label": "Reflections",
            "help": "Screen-space and planar reflections. Applies at the next start.",
            "group": "Picture",
            "advanced": true,
            "defaults": {
                "fefw/reflections": "full"
            },
            "choices": [
                {
                    "label": "Full",
                    "set": {
                        "fefw/reflections": "full"
                    }
                },
                {
                    "label": "Reduced",
                    "set": {
                        "fefw/reflections": "reduced"
                    }
                },
                {
                    "label": "Off",
                    "set": {
                        "fefw/reflections": "off"
                    }
                }
            ]
        },
        {
            "id": "ambient_occlusion",
            "label": "Ambient occlusion",
            "help": "Applies at the next start.",
            "group": "Picture",
            "advanced": true,
            "defaults": {
                "fefw/ambient_occlusion": "1"
            },
            "choices": [
                {
                    "label": "On",
                    "set": {
                        "fefw/ambient_occlusion": "1"
                    }
                },
                {
                    "label": "Off",
                    "set": {
                        "fefw/ambient_occlusion": "0"
                    }
                }
            ]
        },
        {
            "id": "crowd_detail",
            "label": "Crowd detail",
            "help": "Applies at the next start.",
            "group": "Picture",
            "advanced": true,
            "defaults": {
                "fefw/crowd_detail": "full"
            },
            "choices": [
                {
                    "label": "Full",
                    "set": {
                        "fefw/crowd_detail": "full"
                    }
                },
                {
                    "label": "Reduced",
                    "set": {
                        "fefw/crowd_detail": "reduced"
                    }
                }
            ]
        },
        {
            "id": "scenery_detail",
            "label": "Scenery detail",
            "help": "Applies at the next start.",
            "group": "Picture",
            "advanced": true,
            "defaults": {
                "fefw/scenery_detail": "full"
            },
            "choices": [
                {
                    "label": "Full",
                    "set": {
                        "fefw/scenery_detail": "full"
                    }
                },
                {
                    "label": "Reduced",
                    "set": {
                        "fefw/scenery_detail": "reduced"
                    }
                }
            ]
        },
        {
            "id": "npc_distance",
            "label": "Hub NPC draw distance",
            "help": "Multiplies hub townspeople model limit, distance, and draw budget (1 = game default). Higher values use more CPU and memory. Applies at the next start.",
            "group": "Picture",
            "advanced": true,
            "defaults": {
                "fefw/npc_distance": "1"
            },
            "slider": {
                "key": "fefw/npc_distance",
                "min": 1,
                "max": 4,
                "step": 0.5,
                "format": "%g"
            }
        },
        {
            "id": "texture_detail",
            "label": "Texture detail",
            "help": "Pick Half if the game slows down in big areas. Applies at the next start.",
            "group": "Picture",
            "advanced": true,
            "defaults": {
                "gfx/texture_detail": "auto"
            },
            "choices": [
                {
                    "label": "Automatic (half under 9 GB video memory)",
                    "set": {
                        "gfx/texture_detail": "auto"
                    }
                },
                {
                    "label": "Full",
                    "set": {
                        "gfx/texture_detail": "full"
                    }
                },
                {
                    "label": "Half (about 2 GB less video memory)",
                    "set": {
                        "gfx/texture_detail": "half"
                    }
                }
            ]
        },
        {
            "id": "astc_bc",
            "label": "Compact textures",
            "help": "Stores opaque ASTC textures as BC1 instead of BC7, saving ~1 GB of video memory with slight loss on smooth gradients. Applies at the next start.",
            "group": "Picture",
            "advanced": true,
            "defaults": {
                "gfx/astc_bc": "auto"
            },
            "choices": [
                {
                    "label": "Automatic (on under 7 GB video memory)",
                    "set": {
                        "gfx/astc_bc": "auto"
                    }
                },
                {
                    "label": "Off (BC7)",
                    "set": {
                        "gfx/astc_bc": "off"
                    }
                },
                {
                    "label": "On (BC1 for opaque)",
                    "set": {
                        "gfx/astc_bc": "bc1"
                    }
                }
            ]
        },
        {
            "id": "fps_target",
            "label": "Frame rate target",
            "help": "The game runs at 30 on the console. 120 fps needs a fast CPU.",
            "group": "Frame rate",
            "defaults": {
                "fefw/fps60": "0",
                "fefw/fps120": "0"
            },
            "choices": [
                {
                    "label": "30 fps (console)",
                    "set": {
                        "fefw/fps60": "0",
                        "fefw/fps120": "0"
                    }
                },
                {
                    "label": "60 fps",
                    "set": {
                        "fefw/fps60": "1",
                        "fefw/fps120": "0"
                    }
                },
                {
                    "label": "120 fps",
                    "set": {
                        "fefw/fps60": "0",
                        "fefw/fps120": "1"
                    }
                }
            ]
        },
        {
            "id": "smooth_step",
            "label": "Exact game clock",
            "help": "Keeps game time exact when frame times vary.",
            "group": "Frame rate",
            "advanced": true,
            "defaults": {
                "fefw/smooth_step": "0"
            },
            "choices": [
                {
                    "label": "Off",
                    "set": {
                        "fefw/smooth_step": "0"
                    }
                },
                {
                    "label": "On",
                    "set": {
                        "fefw/smooth_step": "1"
                    }
                }
            ]
        },
        {
            "id": "frame_gen",
            "label": "Frame generation",
            "help": "One generated frame between real ones. Best with VSync off on a 120 Hz or faster display.",
            "group": "Frame rate",
            "advanced": true,
            "defaults": {
                "dlss/frame_gen": "0"
            },
            "choices": [
                {
                    "label": "Off",
                    "set": {
                        "dlss/frame_gen": "0"
                    }
                },
                {
                    "label": "NVIDIA DLSS (RTX 40 or newer)",
                    "set": {
                        "dlss/frame_gen": "dlss"
                    }
                },
                {
                    "label": "AMD FSR 3 (Windows only; needs AMD's file)",
                    "set": {
                        "dlss/frame_gen": "fsr3"
                    }
                }
            ]
        },
        {
            "id": "jc2_mouse",
            "label": "Mouse controls",
            "help": "Moving or clicking the mouse switches the game to its mouse controls; a key or the controller switches back.",
            "group": "Input",
            "defaults": {
                "input/jc2_mouse": "auto"
            },
            "choices": [
                {
                    "label": "Automatic (last device used)",
                    "set": {
                        "input/jc2_mouse": "auto"
                    }
                },
                {
                    "label": "Always the mouse",
                    "set": {
                        "input/jc2_mouse": "on"
                    }
                },
                {
                    "label": "Off",
                    "set": {
                        "input/jc2_mouse": "off"
                    }
                }
            ]
        }
    ]
}
